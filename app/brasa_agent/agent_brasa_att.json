        "inputSchema": "{\n  \"round\": 3,\n  \"done_guess\": false,\n  \"reason\": \"Não há sinais claros de email/inbox; tela parece de editor/IDE.\",\n  \"summary\": \"Tela com barra superior (File/Edit/View...), itens como 'Visual Studio Code' e vários ícones 'Next'/'Next >'.\",\n  \"hints\": [\n    \"procurar por 'Gmail' ou 'Inbox'\",\n    \"buscar campo de pesquisa\",\n    \"clicar em 'Next >' para avançar a navegação\",\n    \"usar atalho de busca (ex.: CTRL+L ou CTRL+K dependendo do app)\",\n    \"verificar se há ícone/menu de email\"\n  ],\n  \"evidence\": [\n    \"Textos OCR: 'Visual Studio Code', 'EXPLORER', 'OUTPUT', 'TERMINAL'\",\n    \"Elementos: 'Next', 'Next >', 'Try It All'\"\n  ],\n  \"confidence\": 0.32\n}\n",
